---
import { cursorConfig } from "@/config";
import { url } from "@/utils/url-utils";

const config = {
	...cursorConfig,
	paths: Object.fromEntries(
		Object.entries(cursorConfig.paths).map(([name, path]) => [name, url(path)]),
	),
};
---

<script is:inline define:vars={{ cursorConfig: config }}>
	(function () {
		// 全局标记，确保只初始化一次（兼容 Swup 页面切换）
		if (window.__fireflyCursorInitialized) return;

		// 构建光标 CSS 规则
		// 覆盖 MDN cursor 规范中有 .cur 资源支撑或可语义复用的关键字
		function buildCursorCSS(paths) {
			const rules = [];
			// default：默认指针，应用到所有元素
			if (paths.default) {
				rules.push(`*, *::before, *::after { cursor: url('${paths.default}'), auto !important; }`);
			}
			// pointer：链接/可点击元素
			if (paths.pointer) {
				rules.push(
					`a, button, [role="button"], input[type="button"], input[type="submit"], input[type="reset"], input[type="checkbox"], input[type="radio"], label, select, summary, [tabindex], .clickable, .cursor-pointer { cursor: url('${paths.pointer}'), pointer !important; }`,
				);
			}
			// help：帮助
			if (paths.help) {
				rules.push(`.cursor-help { cursor: url('${paths.help}'), help !important; }`);
			}
			// progress：后台忙碌可交互（aria-busy、loading 约定）
			if (paths.progress) {
				rules.push(
					`[aria-busy="true"], .cursor-progress, [data-loading], .is-loading, .loading { cursor: url('${paths.progress}'), progress !important; }`,
				);
			}
			// text：文本选择
			if (paths.text) {
				rules.push(
					`input[type="text"], input[type="password"], input[type="email"], input[type="number"], input[type="search"], input[type="tel"], input[type="url"], textarea, [contenteditable="true"], [contenteditable=""] { cursor: url('${paths.text}'), text !important; }`,
				);
			}
			// crosshair：十字
			if (paths.crosshair) {
				rules.push(`.cursor-crosshair { cursor: url('${paths.crosshair}'), crosshair !important; }`);
			}
			// move：移动
			if (paths.move) {
				rules.push(`.cursor-move { cursor: url('${paths.move}'), move !important; }`);
			}
			// not-allowed：不可用
			if (paths.notAllowed) {
				rules.push(`[disabled], [aria-disabled="true"], .cursor-not-allowed { cursor: url('${paths.notAllowed}'), not-allowed !important; }`);
			}
			// no-drop：不可放置（语义复用 not-allowed）
			if (paths.noDrop) {
				rules.push(`.cursor-no-drop { cursor: url('${paths.noDrop}'), no-drop !important; }`);
			}
			// grab / grabbing：抓取（语义复用 move）
			if (paths.grab) {
				rules.push(`.cursor-grab { cursor: url('${paths.grab}'), grab !important; }`);
			}
			if (paths.grabbing) {
				rules.push(`.cursor-grabbing { cursor: url('${paths.grabbing}'), grabbing !important; }`);
			}
			// all-scroll：全向滚动（语义复用 move）
			if (paths.allScroll) {
				rules.push(`.cursor-all-scroll { cursor: url('${paths.allScroll}'), all-scroll !important; }`);
			}
			// col-resize / row-resize：列宽/行高调整（语义复用对应双向 resize）
			if (paths.colResize) {
				rules.push(`.cursor-col-resize { cursor: url('${paths.colResize}'), col-resize !important; }`);
			}
			if (paths.rowResize) {
				rules.push(`.cursor-row-resize { cursor: url('${paths.rowResize}'), row-resize !important; }`);
			}
			// 8 方向单向 resize：每个方向独立配置，避免对向被静默忽略
			// 双向 class（ns/ew/nesw/nwse）复用主方向资源
			if (paths.nResize) {
				rules.push(`.cursor-n-resize, .cursor-ns-resize { cursor: url('${paths.nResize}'), n-resize !important; }`);
			}
			if (paths.sResize) {
				rules.push(`.cursor-s-resize { cursor: url('${paths.sResize}'), s-resize !important; }`);
			}
			if (paths.eResize) {
				rules.push(`.cursor-e-resize, .cursor-ew-resize { cursor: url('${paths.eResize}'), e-resize !important; }`);
			}
			if (paths.wResize) {
				rules.push(`.cursor-w-resize { cursor: url('${paths.wResize}'), w-resize !important; }`);
			}
			if (paths.neResize) {
				rules.push(`.cursor-ne-resize, .cursor-nesw-resize { cursor: url('${paths.neResize}'), ne-resize !important; }`);
			}
			if (paths.swResize) {
				rules.push(`.cursor-sw-resize { cursor: url('${paths.swResize}'), sw-resize !important; }`);
			}
			if (paths.nwResize) {
				rules.push(`.cursor-nw-resize, .cursor-nwse-resize { cursor: url('${paths.nwResize}'), nw-resize !important; }`);
			}
			if (paths.seResize) {
				rules.push(`.cursor-se-resize { cursor: url('${paths.seResize}'), se-resize !important; }`);
			}
			return rules.join('\n');
		}

		// 移除已存在的光标样式
		function removeCursorStyle() {
			const existing = document.getElementById('firefly-cursor-style');
			if (existing) existing.remove();
		}

		// 应用光标样式
		function applyCursorStyle(paths) {
			removeCursorStyle();
			if (!paths) return;
			const css = buildCursorCSS(paths);
			if (!css) return;
			const style = document.createElement('style');
			style.id = 'firefly-cursor-style';
			style.textContent = css;
			document.head.appendChild(style);
		}

		// 初始化
		function setup() {
			if (window.__fireflyCursorInitialized) return;
			window.__fireflyCursorInitialized = true;

			// 读取用户偏好
			var stored = localStorage.getItem('cursorEnabled');
			var isEnabled = stored !== null ? stored === 'true' : cursorConfig.enable;

			if (isEnabled) {
				applyCursorStyle(cursorConfig.paths);
			}

			// 监听设置面板切换事件
			window.addEventListener('cursorToggle', function (e) {
				var enabled = e.detail.enabled;
				if (enabled) {
					applyCursorStyle(cursorConfig.paths);
				} else {
					removeCursorStyle();
				}
			});

			// Swup 页面切换后会替换 <head>，导致注入的 <style> 丢失，需要重新应用
			// 同时监听两种事件以兼容不同 Swup 版本/插件
			document.addEventListener('swup:contentReplaced', function () {
				var s = localStorage.getItem('cursorEnabled');
				var enabled = s !== null ? s === 'true' : cursorConfig.enable;
				if (enabled) {
					applyCursorStyle(cursorConfig.paths);
				}
			});
			document.addEventListener('swup:content:replace', function () {
				var s = localStorage.getItem('cursorEnabled');
				var enabled = s !== null ? s === 'true' : cursorConfig.enable;
				if (enabled) {
					applyCursorStyle(cursorConfig.paths);
				}
			});
			// Swup 启用后注册 hook（首次加载时 Swup 可能还未初始化）
			document.addEventListener('swup:enable', function () {
				if (window.swup && window.swup.hooks) {
					window.swup.hooks.on('content:replace', function () {
						var s = localStorage.getItem('cursorEnabled');
						var enabled = s !== null ? s === 'true' : cursorConfig.enable;
						if (enabled) {
							applyCursorStyle(cursorConfig.paths);
						}
					});
				}
			});
			// 若 Swup 已就绪（如从详情页返回时），直接注册 hook
			if (window.swup && window.swup.hooks) {
				window.swup.hooks.on('content:replace', function () {
					var s = localStorage.getItem('cursorEnabled');
					var enabled = s !== null ? s === 'true' : cursorConfig.enable;
					if (enabled) {
						applyCursorStyle(cursorConfig.paths);
					}
				});
			}
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setup);
		} else {
			setup();
		}
	})();
</script>
